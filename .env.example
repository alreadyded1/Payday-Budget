# Environment Variables Configuration
# Copy this file to .env and set your values

# REQUIRED: Secret key for Flask session encryption
# Generate a new one with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Set to 'true' when running with HTTPS (production)
HTTPS_ENABLED=false

# Flask environment (development or production)
FLASK_ENV=development

# Flask debug mode (set to false in production)
FLASK_DEBUG=false
